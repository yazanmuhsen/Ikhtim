# Khitmah Environment Variables

# Backend Port (default: 5000)
PORT=5000

# PostgreSQL Connection String (Optional)
# If left empty, Khitmah automatically uses embedded PostgreSQL (PGlite) with local disk persistence in ./server/data/pgdata.
# To connect to external PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/khitmah
# DATABASE_SSL=false

# Node DNS result order for fast Quran API resolution
NODE_OPTIONS=--dns-result-order=ipv4first
